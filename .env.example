# Copy to .env.local and fill in from your Supabase project settings.
# The anon key is meant to ship in the browser; RLS and Supabase Auth enforce
# access. NEVER put the service_role key here or in any frontend build.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional ISO 4217 currency code used by the UI (default: EUR).
VITE_CURRENCY=EUR
